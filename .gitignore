# local backups and logs
index.html.bak-*
scripts/*.log

# working files, not part of the site
index.html.txt
quoteme.txt

# tooling - the site serves the repo root publicly, so keep these out
.mcp.json
scripts/
*.bat

# source masters: the script converts these to .mp4, so the .mov never ships.
# Pattern, not a filename list - a named list misses every new clip.
video/*.mov
video/*.MOV
video/*.converting.mp4
